{
  "manifest_version": 3,
  "name": "Schnell lesen",
  "version": "1.3.1",
  "description": "Liest markierten Text, den Hauptinhalt einer Seite oder einzelne LinkedIn-Beiträge Wort für Wort mit Fixierungsbuchstaben (RSVP).",
  "permissions": ["activeTab", "scripting", "contextMenus", "storage"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["rsvp.js", "content.js", "linkedin.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Schnell lesen (Alt+Shift+R)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+R", "mac": "Alt+Shift+R" },
      "description": "Schnell lesen: Auswahl oder Seite"
    }
  }
}
